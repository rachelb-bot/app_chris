# Copy to .env (or set in your host's dashboard). All optional.
PORT=3000
# Where the SQLite database + uploaded files live. Mount a persistent volume here.
DATA_DIR=./data
# Public URL used in client links inside emails (quotes, invoices)
PUBLIC_URL=https://ops.yourcompany.ie
# Set to false only if you serve over plain http (e.g. local network)
COOKIE_SECURE=true
# Outgoing email (quotes, invoices, campaigns). Without these, emails are logged to the outbox only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Bright Spark Electrical <office@yourcompany.ie>"
