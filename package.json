{
  "name": "voltline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Voltline — all-in-one operations platform for an electrical contracting company",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "seed:demo": "node server/seed-demo.js",
    "test": "node --test server/test/*.test.js",
    "build:preview": "VITE_DEMO=1 vite build -c vite.demo.config.js && node scripts/pack-preview.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "leaflet": "^1.9.4",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "sql.js": "^1.13.0",
    "vite": "^8.3.6"
  }
}
